---
import { getCollection } from 'astro:content';
import Gallery from '../components/Gallery.astro';
import Base from '../layouts/Base.astro';

const publications = (await getCollection('publications'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const totalCount = publications.length;
---

<Base
  title="Writing - Mike Bagwell"
  description="Browse all published poems and creative work by Mike Bagwell"
>
  <div class="page-shell">
    <div class="reveal mb-12">
      <h1 class="font-display text-[clamp(5rem,11vw,7rem)] font-extrabold leading-[0.95] tracking-tight text-[var(--color-ink)] mb-4">
        Writing
      </h1>
      <p class="text-xl text-[var(--color-mute)]">
        <span class="hidden md:inline">Hover a cover for an excerpt.</span>
        <span class="md:hidden">Tap a cover to open the piece.</span>
      </p>
    </div>

    <div class="reveal">
      <Gallery />
    </div>
  </div>
</Base>
