---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';

const designProjects = await getCollection('design');
const sortedProjects = designProjects.sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Design - Mike Bagwell"
  description="Design and publication work by Mike Bagwell"
>
  <div class="page-shell">
    <header class="reveal mb-12">
      <h1 class="font-display text-[clamp(5rem,11vw,7rem)] font-extrabold leading-[0.95] tracking-tight text-[var(--color-ink)]">
        Design
      </h1>
      <p class="mt-4 text-xl text-[var(--color-mute)] max-w-3xl">
        Publication design, print objects, and collaborative book work.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10">
      {sortedProjects.map((project, i) => (
        <a
          href={`/design/${project.data.slug}`}
          class="group reveal block no-underline text-inherit"
          style={`transition-delay: ${Math.min(i * 60, 240)}ms`}
        >
          <article>
            <div class="mb-4 overflow-hidden rounded-[2px] bg-[var(--color-media)] border border-[var(--color-line)] aspect-[4/5]">
              {project.data.coverImage && (
                <Picture
                  src={project.data.coverImage}
                  alt={project.data.title}
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  widths={[400, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  formats={['avif', 'webp']}
                />
              )}
            </div>
            <h2 class="font-display text-2xl font-normal tracking-tight mb-1 group-hover:underline decoration-[var(--color-accent)] decoration-2 underline-offset-4">
              {project.data.title}
            </h2>
            {project.data.description && project.data.description !== project.data.title && (
              <p class="text-[var(--color-mute)] line-clamp-2 text-sm">
                {project.data.description}
              </p>
            )}
          </article>
        </a>
      ))}
    </div>
  </div>
</Base>
