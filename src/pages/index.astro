---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { renderBioMarkdown } from '../lib/bio-markdown';
import bioMarkdown from '../content/bio.md?raw';
import portrait from '../assets/author/portrait.jpg';

const bioHtml = renderBioMarkdown(bioMarkdown);

const featuredPublications = (await getCollection('publications'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const books = (await getCollection('books'))
  .filter((b) => !b.data.hideFromMain)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Base>
  <div class="page-shell">
    <section class="reveal grid lg:grid-cols-[380px_minmax(0,1fr)] gap-10 lg:gap-14 items-start mb-20 lg:mb-28">
      <div class="w-full max-w-[380px] mx-auto lg:mx-0">
        <div class="portrait-frame">
          <Image
            src={portrait}
            alt="Mike Bagwell portrait"
            class="w-full h-auto block"
            widths={[380, 760]}
            sizes="380px"
            loading="eager"
          />
        </div>
      </div>

      <div>
        <h1 class="font-display text-[clamp(5.5rem,13vw,8rem)] font-extrabold leading-[0.95] tracking-tight text-[var(--color-ink)] mb-6">
          Mike Bagwell
        </h1>
        <div class="prose prose-xl max-w-3xl" set:html={bioHtml} />
      </div>
    </section>

    <section class="reveal mb-20 lg:mb-28">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="display-section text-[var(--color-ink)]">
            Books
          </h2>
          <p class="mt-3 text-lg text-[var(--color-mute)] max-w-2xl">
            Chapbooks and micros - the objects holding the work.
          </p>
        </div>
        <a href="/books" class="btn-ghost shrink-0">All books →</a>
      </div>

      <div class="book-shelf" role="list">
        {books.map((book) => {
          const href = book.data.url || '/books';
          const external = /^https?:\/\//i.test(href);
          return (
            <a
              href={href}
              class="book-tile"
              role="listitem"
              {...(external
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              <Image
                src={book.data.image}
                alt=""
                class="book-tile__cover"
                widths={[240, 480]}
                sizes="(min-width: 1200px) 240px, 220px"
                loading="lazy"
                decoding="async"
              />
              <h3 class="book-tile__title">
                {book.data.shortTitle || book.data.title}
              </h3>
              <p class="book-tile__press">{book.data.press}</p>
            </a>
          );
        })}
      </div>
    </section>

    {featuredPublications.length > 0 && (
      <section class="reveal mb-20 lg:mb-28">
        <Gallery featured={true} carousel={true} />
      </section>
    )}

    <section class="reveal">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <h2 class="display-section text-[var(--color-ink)]">
          Recent writing
        </h2>
        <p class="text-base font-semibold text-[var(--color-mute)]">
          Hover a cover to peek at the poem
        </p>
      </div>
      <Gallery limit={12} />
      <div class="mt-12">
        <a href="/writing" class="btn-primary">
          All publications
        </a>
      </div>
    </section>
  </div>
</Base>
