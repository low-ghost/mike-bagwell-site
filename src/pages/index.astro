---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import portrait from '../assets/author/portrait.jpg';
import Gallery from '../components/Gallery.astro';
import KineticText from '../components/KineticText.astro';
import Base from '../layouts/Base.astro';
import { getShelfBooks, notableBookJsonLd } from '../lib/books';
import { profilePageSchema } from '../lib/seo-schema';
import { normalizeHttpUrl } from '../lib/urls';

const bioEntry = await getEntry('site', 'bio');
if (!bioEntry) throw new Error('Missing content entry: site/bio');
const { Content: BioContent } = await render(bioEntry);

const publications = await getCollection('publications');

const featuredPublications = publications
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const books = await getShelfBooks();

const tickerPubs: { name: string; url: string; title: string }[] = [];
const seenPublishers = new Set<string>();
for (const pub of publications
  .slice()
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 24)) {
  if (seenPublishers.has(pub.data.publisher)) continue;
  const url = normalizeHttpUrl(pub.data.url);
  if (!url) continue;
  seenPublishers.add(pub.data.publisher);
  tickerPubs.push({
    name: pub.data.publisher,
    url,
    title: pub.data.title,
  });
  if (tickerPubs.length >= 14) break;
}

const notableBookEntries = await notableBookJsonLd(books, Astro.site);
---

<Base
  type="profile"
  schema={[
    profilePageSchema('https://mikebagwell.me/'),
    ...notableBookEntries,
  ]}
>
  <div class="page-shell">
    <section class="hero-block grid lg:grid-cols-[380px_minmax(0,1fr)] gap-10 lg:gap-14 items-start mb-16 lg:mb-24">
      <div class="w-full max-w-[380px] mx-auto lg:mx-0">
        <div class="portrait-frame portrait-frame--live" data-parallax="0.22">
          <Image
            src={portrait}
            alt="Mike Bagwell portrait"
            class="w-full h-auto block portrait-img"
            widths={[380, 760]}
            sizes="380px"
            loading="eager"
          />
          <div class="portrait-sheen" aria-hidden="true"></div>
        </div>
      </div>

      <div>
        <KineticText
          text="Mike Bagwell"
          as="h1"
          mode="chars"
          when="load"
          scramble
          class="kinetic--hero font-display text-[clamp(5.5rem,13vw,8rem)] font-extrabold leading-[0.95] tracking-tight text-[var(--color-ink)] mb-6"
        />
        <div class="prose prose-xl max-w-3xl" data-kinetic-bio>
          <BioContent />
        </div>
      </div>
    </section>

    {
      tickerPubs.length > 0 && (
        <div
          class="journal-marquee mb-20 lg:mb-28"
          role="region"
          aria-label="Recent journals"
        >
          <div class="journal-marquee__track" data-marquee>
            {tickerPubs.map((item) => (
              <a
                href={item.url}
                class="journal-marquee__item"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${item.name}: ${item.title}`}
              >
                {item.name}
              </a>
            ))}
            {tickerPubs.map((item) => (
              <a
                href={item.url}
                class="journal-marquee__item"
                target="_blank"
                rel="noopener noreferrer"
                tabindex="-1"
                aria-hidden="true"
              >
                {item.name}
              </a>
            ))}
          </div>
        </div>
      )
    }

    <section class="reveal mb-20 lg:mb-28">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div>
          <KineticText
            text="Books"
            as="h2"
            mode="chars"
            when="scroll"
            scramble
            class="display-section text-[var(--color-ink)]"
          />
        </div>
        <a href="/books/" class="btn-ghost shrink-0 stagger-child">All books →</a>
      </div>

      <div class="book-shelf" role="list">
        {books.map((book) => {
          const href = book.data.url || '/books/';
          const external = book.data.url.length > 0;
          const shelfTitle = book.data.shortTitle || book.data.title;
          return (
            <a
              href={href}
              class="book-tile"
              role="listitem"
              {...(external
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              <Image
                src={book.data.image}
                alt={`${book.data.title} cover`}
                class="book-tile__cover"
                widths={[240, 480]}
                sizes="(min-width: 1200px) 240px, 220px"
                loading="lazy"
                decoding="async"
              />
              <h3 class="book-tile__title">
                {shelfTitle}
              </h3>
              <p class="book-tile__press">{book.data.press}</p>
            </a>
          );
        })}
      </div>
    </section>

    {featuredPublications.length > 0 && (
      <section class="reveal mb-20 lg:mb-28">
        <Gallery featured={true} carousel={true} />
      </section>
    )}

    <section class="reveal">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <KineticText
          text="Recent writing"
          as="h2"
          mode="chars"
          when="scroll"
          scramble
          class="display-section text-[var(--color-ink)]"
        />
        <p class="text-base font-semibold text-[var(--color-mute)] stagger-child">
          <span class="hidden md:inline">Hover a cover to peek at the poem</span>
          <span class="md:hidden">Scroll to peek · tap to open</span>
        </p>
      </div>
      <Gallery limit={12} />
      <div class="mt-12">
        <a href="/writing/" class="btn-primary stagger-child">
          All publications
        </a>
      </div>
    </section>
  </div>
</Base>
