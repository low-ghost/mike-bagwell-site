---
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { renderBioMarkdown } from '../lib/bio-markdown';
import { bookListSchema, collectionPageSchema } from '../lib/seo-schema';

const books = (await getCollection('books')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const pageUrl = 'https://mikebagwell.me/books/';
const title = 'Books | Mike Bagwell';
const description =
  'Chapbooks and collections by Mike Bagwell, including Poem of Thanks and other published books from Thirty West, Metatron, Bottlecap, and more.';

const schemaBooks = await Promise.all(
  books.map(async (book) => {
    const optimized = await getImage({
      src: book.data.image,
      width: 800,
      format: 'jpg',
    });
    const href = book.data.url?.trim();
    return {
      title: book.data.title,
      press: book.data.press,
      pubDate: book.data.pubDate,
      url: href && /^https?:\/\//i.test(href) ? href : undefined,
      image: new URL(optimized.src, Astro.site).href,
    };
  })
);
---

<Base
  title={title}
  description={description}
  schema={[
    collectionPageSchema({ url: pageUrl, name: title, description }),
    bookListSchema(schemaBooks),
  ]}
>
  <div class="page-shell">
    <header class="reveal mb-12">
      <h1 class="font-display text-[clamp(5rem,11vw,7rem)] font-extrabold leading-[0.95] tracking-tight text-[var(--color-ink)]">
        Books
      </h1>
      <p class="mt-4 text-xl text-[var(--color-mute)] max-w-2xl">
        Chapbooks and published collections.
      </p>
    </header>

    <div class="space-y-24">
      {books.map((book, i) => {
        const { title, press, description, image, url, linkLabel } = book.data;
        const descriptionHtml = renderBioMarkdown(description);
        const hasExternalUrl = /^https?:\/\//i.test(url);
        const ctaHtml =
          hasExternalUrl && linkLabel
            ? renderBioMarkdown(`[${linkLabel}](${url})`)
            : '';

        return (
          <section class="reveal book-entry">
            <div class="book-entry__cover">
              <Image 
                src={image} 
                alt={`${title} cover`}
                class="book-entry__image"
                widths={[360, 720]}
                sizes="(max-width: 768px) 70vw, 280px"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
            <div>
              <h2 class="font-display text-4xl font-normal tracking-tight mb-3">
                {hasExternalUrl ? (
                  <a href={url} target="_blank" rel="noopener noreferrer" class="hover:opacity-70 transition-opacity">
                    <em>{title}</em>
                  </a>
                ) : (
                  <em>{title}</em>
                )}
              </h2>
              <p class="text-lg text-[var(--color-mute)] mb-4">
                {press}
              </p>
              <div class="prose prose-xl" set:html={descriptionHtml + ctaHtml} />
            </div>
          </section>
        );
      })}
    </div>
  </div>
</Base>
