---
import { Image } from 'astro:assets';
import KineticText from '../components/KineticText.astro';
import Base from '../layouts/Base.astro';
import { bookListItems, getBooksWithContent } from '../lib/books';
import { bookListSchema, collectionPageSchema } from '../lib/seo-schema';

const books = await getBooksWithContent();

const pageUrl = 'https://mikebagwell.me/books/';
const title = 'Books | Mike Bagwell';
const description =
  'Chapbooks and collections by Mike Bagwell, including Poem of Thanks and other published books from Thirty West, Metatron, Bottlecap, and more.';

const schemaBooks = await bookListItems(
  books.map(({ book }) => book),
  Astro.site
);
---

<Base
  title={title}
  description={description}
  schema={[
    collectionPageSchema({ url: pageUrl, name: title, description }),
    bookListSchema(schemaBooks),
  ]}
>
  <div class="page-shell">
    <header class="mb-12">
      <KineticText
        text="Books"
        as="h1"
        mode="chars"
        when="load"
        scramble
        class="kinetic--hero font-display text-[clamp(5rem,11vw,7rem)] font-extrabold leading-[0.95] tracking-tight text-[var(--color-ink)]"
      />
      <p class="mt-4 text-xl text-[var(--color-mute)] max-w-2xl">
        Chapbooks and published collections.
      </p>
    </header>

    <div class="space-y-24">
      {
        books.map(({ book, Content }, i) => {
          const { title, press, image, url, linkLabel } = book.data;
          const hasExternalUrl = url.length > 0;

          return (
            <section class="reveal book-entry">
              <div class="book-entry__cover">
                <Image
                  src={image}
                  alt={`${title} cover`}
                  class="book-entry__image"
                  widths={[360, 720]}
                  sizes="(max-width: 768px) 70vw, 280px"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <div>
                <h2 class="font-display text-4xl font-normal tracking-tight mb-3">
                  {hasExternalUrl ? (
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:opacity-70 transition-opacity"
                    >
                      <em>{title}</em>
                    </a>
                  ) : (
                    <em>{title}</em>
                  )}
                </h2>
                <p class="text-lg text-[var(--color-mute)] mb-4">{press}</p>
                <div class="prose prose-xl">
                  <Content />
                  {hasExternalUrl && linkLabel && (
                    <p>
                      <a href={url} target="_blank" rel="noopener noreferrer">
                        {linkLabel}
                      </a>
                    </p>
                  )}
                </div>
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</Base>
