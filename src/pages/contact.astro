---
import Base from '../layouts/Base.astro';

// Web3Forms access key should be set as environment variable
const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY || 'YOUR_ACCESS_KEY_HERE';
const isSuccess = Astro.url.searchParams.get('success') === 'true';
---

<Base
  title="Contact | Mike Bagwell"
  description="Contact Mike Bagwell for collaborations, readings, translation, design, or other inquiries."
  noindex={isSuccess}
>
  <div class="page-shell">
    <div class="max-w-2xl">
    <h1 class="reveal font-display text-[clamp(4.5rem,10vw,6.5rem)] font-extrabold leading-[0.95] mb-8 tracking-tight text-[var(--color-ink)]">
      Contact
    </h1>

    <div class="prose prose-lg mb-12">
      <p>
        Have a question, collaboration idea, or just want to say hello? Send me a message using the form below.
      </p>
    </div>

    <form 
      action="https://api.web3forms.com/submit" 
      method="POST"
      class="space-y-6"
    >
      <!-- Web3Forms access key -->
      <input type="hidden" name="access_key" value={accessKey} />
      
      <!-- Honeypot spam protection -->
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
      
      <!-- Redirect after submission (optional) -->
      <input type="hidden" name="redirect" value="https://mikebagwell.me/contact/?success=true" />

      <div>
        <label for="name" class="block text-sm font-semibold mb-2 text-[var(--color-ink)]">
          Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-4 py-3 rounded-[2px] border border-[var(--color-line)] bg-[var(--color-panel)] text-[var(--color-ink)] focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent outline-none transition-colors"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold mb-2 text-[var(--color-ink)]">
          Email
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-3 rounded-[2px] border border-[var(--color-line)] bg-[var(--color-panel)] text-[var(--color-ink)] focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent outline-none transition-colors"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold mb-2 text-[var(--color-ink)]">
          Message
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          class="w-full px-4 py-3 rounded-[2px] border border-[var(--color-line)] bg-[var(--color-panel)] text-[var(--color-ink)] focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent outline-none transition-colors resize-y"
        ></textarea>
      </div>

      <div>
        <button
          type="submit"
          class="btn-primary w-full justify-center"
        >
          Send Message
        </button>
      </div>
    </form>

    {Astro.url.searchParams.get('success') === 'true' && (
      <div class="mt-8 p-4 bg-[color-mix(in_oklab,var(--color-accent)_16%,transparent)] border border-[var(--color-accent)] rounded-[2px]">
        <p class="text-[var(--color-accent-deep)] font-semibold">
          Message sent successfully. I'll get back to you soon.
        </p>
      </div>
    )}

    <div class="mt-12 text-sm text-[var(--color-mute)]">
      <p>
        You can also find me on <a href="https://www.instagram.com/low_gh0st/" target="_blank" rel="noopener noreferrer" class="underline text-[var(--color-accent-deep)] hover:text-[var(--color-accent)]">Instagram</a> and <a href="https://twitter.com/low_gh0st" target="_blank" rel="noopener noreferrer" class="underline text-[var(--color-accent-deep)] hover:text-[var(--color-accent)]">Twitter</a>.
      </p>
    </div>
    </div>
  </div>
</Base>

<script>
  // Handle form submission for better UX
  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', function() {
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (button) {
        button.textContent = 'Sending...';
        button.disabled = true;
      }
    });
  }
</script>
