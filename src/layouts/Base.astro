---
import Seo from '../components/Seo.astro';
import {
  jsonLdGraph,
  personSchema,
  websiteSchema,
  SAME_AS,
} from '../lib/seo-schema';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  noindex?: boolean;
  /** Extra JSON-LD nodes merged into @graph with Person + WebSite */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  image,
  imageAlt,
  type,
  publishedTime,
  noindex,
  schema = [],
} = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Home', match: (p: string) => p === '/' },
  { href: '/writing/', label: 'Writing', match: (p: string) => p.startsWith('/writing') },
  { href: '/books/', label: 'Books', match: (p: string) => p.startsWith('/books') },
  { href: '/design/', label: 'Design', match: (p: string) => p.startsWith('/design') },
  { href: '/music/', label: 'Music', match: (p: string) => p.startsWith('/music') },
  { href: '/contact/', label: 'Contact', match: (p: string) => p.startsWith('/contact') },
];

const structuredData = jsonLdGraph([personSchema(), websiteSchema(), ...schema]);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      publishedTime={publishedTime}
      noindex={noindex}
    />
    {SAME_AS.map((href) => <link rel="me" href={href} />)}
    <link
      rel="preload"
      href="/fonts/trap/Trap-ExtraBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/trap/Trap-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/trap/Trap-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
  </head>
  <body class="site-body antialiased">
    <div class="site-atmosphere" aria-hidden="true"></div>
    <div class="min-h-screen flex flex-col relative z-[1]">
      <header class="site-header">
        <nav class="site-rail" aria-label="Primary">
          <div class="flex justify-between items-center min-h-16 md:min-h-[4.25rem] gap-4 py-2.5 overflow-visible">
            <a href="/" class="site-brand shrink-0">
              Mike Bagwell
            </a>

            <div class="hidden md:flex gap-6 lg:gap-8 py-1">
              {nav.map((item) => (
                <a
                  href={item.href}
                  class:list={['nav-link', item.match(path) && 'nav-link-active']}
                  aria-current={item.match(path) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </div>

            <button
              type="button"
              class="nav-toggle md:hidden"
              aria-expanded="false"
              aria-controls="mobile-nav"
              data-nav-toggle
            >
              <span class="sr-only">Menu</span>
              <span class="nav-toggle__bars" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
              </span>
            </button>
          </div>
        </nav>
      </header>

      <div
        id="mobile-nav"
        class="mobile-nav md:hidden"
        data-mobile-nav
        aria-hidden="true"
      >
        <div class="mobile-nav__panel">
          <nav class="mobile-nav__links" aria-label="Mobile">
            {nav.map((item, i) => (
              <a
                href={item.href}
                class:list={['mobile-nav__link', item.match(path) && 'mobile-nav__link--active']}
                aria-current={item.match(path) ? 'page' : undefined}
                style={`--i: ${i}`}
                data-nav-close
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="mt-24 border-t border-[var(--color-line)]">
        <div class="site-rail py-12">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-5">
            <div class="space-y-3">
              <p class="text-sm font-semibold text-[var(--color-ink)]">
                &copy; {new Date().getFullYear()} Mike Bagwell
              </p>
              <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm font-semibold text-[var(--color-mute)]" aria-label="Footer">
                <a class="hover:text-[var(--color-ink)] transition-colors" href="/writing/">Writing</a>
                <a class="hover:text-[var(--color-ink)] transition-colors" href="/books/">Books</a>
                <a class="hover:text-[var(--color-ink)] transition-colors" href="/design/">Design</a>
                <a class="hover:text-[var(--color-ink)] transition-colors" href="/music/">Music</a>
                <a class="hover:text-[var(--color-ink)] transition-colors" href="/contact/">Contact</a>
              </nav>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
              <a
                class="social-link"
                href="https://www.instagram.com/low_gh0st/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                </svg>
              </a>
              <a
                class="social-link"
                href="https://twitter.com/low_gh0st"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Twitter / X"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z" />
                </svg>
              </a>
              <a
                class="social-link"
                href="https://lowgh0st.bandcamp.com"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Bandcamp"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M0 18.75l7.437-13.5H24l-7.438 13.5H0z" />
                </svg>
              </a>
              <a class="social-link" href="/rss.xml" aria-label="RSS feed">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6.18 15.64a2.18 2.18 0 012.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82c0-1.2.98-2.18 2.18-2.18M4 4.44c8.06.22 14.56 6.72 14.78 14.78h-2.9c-.2-6.52-5.36-11.68-11.88-11.88V4.44m0 4.82A10.93 10.93 0 0115.5 20.22h-2.86A8.07 8.07 0 004 11.58V9.26z" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const reveal = () => {
        const nodes = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!nodes.length) return;
        if (!('IntersectionObserver' in window)) {
          nodes.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        // threshold 0: tall sections (e.g. full writing gallery) can never
        // meet a fractional threshold when taller than the viewport.
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -4% 0px', threshold: 0 }
        );
        nodes.forEach((el) => io.observe(el));
      };

      const bindNav = () => {
        const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
        const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');
        if (!toggle || !panel || toggle.dataset.bound === '1') return;
        toggle.dataset.bound = '1';

        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.classList.toggle('is-open', open);
          panel.classList.toggle('is-open', open);
          panel.setAttribute('aria-hidden', String(!open));
          document.body.classList.toggle('nav-open', open);
          if (open) {
            const first = panel.querySelector<HTMLAnchorElement>('.mobile-nav__link');
            first?.focus({ preventScroll: true });
          } else {
            toggle.focus({ preventScroll: true });
          }
        };

        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });

        panel.querySelectorAll('[data-nav-close]').forEach((el) => {
          el.addEventListener('click', () => setOpen(false));
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
          }
        });
      };

      reveal();
      bindNav();
      document.addEventListener('astro:page-load', () => {
        reveal();
        bindNav();
      });
    </script>
  </body>
</html>
