---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ModalTrigger } from './ModalTrigger';

export interface Props {
  title: string;
  publisher: string;
  url: string;
  pubDate: Date;
  image: ImageMetadata;
  excerpt?: string;
  archivedBody?: string;
  /** Eager-load above-the-fold covers; default lazy */
  priority?: boolean;
}

const {
  title,
  publisher,
  url,
  pubDate,
  image,
  excerpt,
  archivedBody,
  priority = false,
} = Astro.props;

function normalizeUrl(url: string): string {
  if (!url) return '';
  if (url.startsWith('http://') || url.startsWith('https://')) return url;
  return `https://${url}`;
}

const normalizedUrl = normalizeUrl(url);
const hasExternalUrl = normalizedUrl.length > 0;
const hasArchivedContent = !!archivedBody;
const useArchiveModal = !hasExternalUrl && hasArchivedContent;
const isArchived = !hasExternalUrl && !hasArchivedContent;

const Tag = hasExternalUrl ? 'a' : 'div';
const mediaRatio = `${image.width} / ${image.height}`;
---

<Tag
  class:list={['pub-card group', isArchived && 'pub-card--archived']}
  {...(hasExternalUrl && {
    href: normalizedUrl,
    target: '_blank',
    rel: 'noopener noreferrer',
  })}
>
  <div class="pub-card__media" style={`--media-ratio: ${mediaRatio}`}>
    <Picture
      src={image}
      alt=""
      formats={['webp']}
      fallbackFormat="jpg"
      widths={[420, 640, 900]}
      sizes="(min-width: 1100px) 24vw, (min-width: 768px) 32vw, 46vw"
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : 'auto'}
      class="pub-card__image"
    />
    {excerpt && (
      <div class="pub-card__excerpt" aria-hidden="true">
        <p>{excerpt}</p>
      </div>
    )}
  </div>
  <div class="pub-card__meta">
    <h3 class="pub-card__title">{title}</h3>
    <p class="pub-card__publisher">{publisher}</p>
    <time class="pub-card__date" datetime={pubDate.toISOString()}>
      {pubDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      })}
    </time>
  </div>
  {useArchiveModal && (
    <ModalTrigger
      title={title}
      publisher={publisher}
      archivedBody={archivedBody!}
      client:visible
    />
  )}
</Tag>
