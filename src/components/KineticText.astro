---
/**
 * Kinetic headline — chars/words split for GSAP.
 * Visual spans are aria-hidden; accessible name stays on the heading.
 *
 * Char mode still animates per glyph, but letters are wrapped in nowrap
 * word groups so line breaks never land mid-word (e.g. "Mike B" / "agwell").
 */
export interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p' | 'span';
  class?: string;
  mode?: 'chars' | 'words';
  /** Play entrance on scroll (default) or immediately on load */
  when?: 'load' | 'scroll';
  /** Optional hover scramble (display titles only) */
  scramble?: boolean;
}

const {
  text,
  as: Tag = 'h1',
  class: className = '',
  mode = 'chars',
  when = 'scroll',
  scramble = false,
} = Astro.props;

/** Tokens: words and whitespace runs preserved for wrapping control */
const tokens = text.split(/(\s+)/).filter((p: string) => p.length > 0);

let unitIndex = 0;
---

<Tag
  class:list={['kinetic', className]}
  data-kinetic={mode}
  data-kinetic-when={when}
  data-scramble={scramble ? 'true' : undefined}
  aria-label={text}
>
  <span class="kinetic__visual" aria-hidden="true">
    {
      tokens.map((token: string) => {
        if (/^\s+$/.test(token)) {
          return <span class="kinetic__space">&nbsp;</span>;
        }

        if (mode === 'words') {
          const i = unitIndex++;
          return (
            <span class="kinetic__word" style={`--i: ${i}`}>
              <span class="kinetic__inner" data-text={token}>
                {token}
              </span>
            </span>
          );
        }

        // chars: keep the word on one line; animate glyphs inside
        const chars = Array.from(token);
        return (
          <span class="kinetic__word-group">
            {
              chars.map((ch: string) => {
                const i = unitIndex++;
                return (
                  <span class="kinetic__char" style={`--i: ${i}`}>
                    <span class="kinetic__inner" data-char={ch} data-text={ch}>
                      {ch}
                    </span>
                  </span>
                );
              })
            }
          </span>
        );
      })
    }
  </span>
</Tag>
