  "archivedBody": "<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6483697c2a64fd3f9b08570f\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/a9032d95-ba0b-473e-a531-82cdd71f9f84_789/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/a9032d95-ba0b-473e-a531-82cdd71f9f84_789/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"yui_3_17_2_1_1686333821209_18846\" id=\"block-yui_3_17_2_1_1686333821209_18846\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p class=\"\" style=\"white-space:pre-wrap;\"><em>Originally published in </em><a href=\"https://umbrellafactorymagazine.com\"><span style=\"text-decoration:underline\"><em>Umbrella Factory Magazine</em></span></a><em>, Issue 7</em></p><p class=\"\" style=\"white-space:pre-wrap;\"><em>“The Name of the Father” also published in </em><a href=\"https://www.mikebagwell.me/or-else-they-are-trees\"><em>Or Else they are Trees</em></a></p></div>\n\n\n  \n<style id=\"container-styles\">#block-yui_3_17_2_1_1686333821209_18846 {\n    \n    \n    \n\n\n\n  }\n\n  #block-yui_3_17_2_1_1686333821209_18846 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-yui_3_17_2_1_1686333821209_18846 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-yui_3_17_2_