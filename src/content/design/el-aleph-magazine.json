  "body": "<div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><h2 style=\"white-space:pre-wrap;\">El Aleph Magazine</h2>\n\n<div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"text-align:center;white-space:pre-wrap;\" class=\"sqsrte-large\">El Aleph Press’ first magazine is a handmade collection of over 50 phenomenal artists and writers. The publication exploits the full possibilities of print and digital media by combining poetry, fiction, artwork and comics in a hand-bound volume with silk-screened covers, full color interior, a sewn chapbook, and gorgeous painted menko card inserts as well as an extensive online showcase of multimedia poems, videos and spoken word projects linked through QR codes.</p>\n\n\n  \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<div class=\"sqs-block-socialaccountlinks-content\">\n  <div class=\"sqs-svg-icon--outer social-icon-alignment-center social-icons-color-black social-icons-size-medium social-icons-style-regular \">\n    <style>\n      \n      #block-f103d0b2e3d5b460e844 {\n        --social-icons-justify-content: center;\n        --social-icons-dimension: 24px;--social-icons-gap: 14px;\n        --social-icons-border-thickness: 2px;\n      }\n\n      \n      #block-f103d0b2e3d5b460e844 .sqs-svg-icon--wrapper {\n        --si-border-radius: 0;--si-scale: 2;--si-box-shadow: none;--si-fill-icon: var(--si-primary);--si-fill-icon-fade: var(--si-primary-faded);--si-fill-icon-hover: var(--si-primary);--si-fill-mask: transparent;--si-fill-mask-fade: transparent;--si-fill-mask-hover: transparent;--si-bg: transparent;--si-bg-fade: transparent;--si-bg-hover: transparent;\n      }\n\n      \n      #block-f103d0b2e3d5b460e844 .sqs-svg-icon--list {\n        justify-content: var(--social-icons-justify-content, center);\n        column-gap: var(--social-icons-gap, 12px);\n        row-gap: var(--social-icons-gap, 12px);\n      }\n      #block-f103d0b2e3d5b460e844 .sqs-svg-icon--wrapper {\n        width: var(--social-icons-dimension, 20px);\n        height: var(--social-icons-dimension, 20px);\n        margin: 0;\n        border: none; \n        background-color: var(--si-bg, transparent);\n        box-shadow: var(--si-box-shadow, none);\n        border-radius: var(--si-border-radius, 0);\n      }\n      #block-f103d0b2e3d5b460e844 .sqs-svg-icon--wrapper > div {\n        transform: scale(var(--si-scale, 1));\n      }\n      #block-f103d0b2e3d5b460e844 .sqs-use--icon {\n        fill: var(--si-fill-icon, transparent);\n      }\n      #block-f103d0b2e3d5b460e844 .sqs-use--mask {\n        fill: var(--si-fill-mask, transparent);\n      }\n      #block-f103d0b2e3d5b460e844 .sqs-svg-icon--list:hover .sqs-svg-icon--wrapper {\n        background-color: var(--si-bg-fade, var(--si-bg, transparent));\n      }\n      #block-f103d0b2e3d5b460e844 .sqs-svg-icon--list:hover .sqs-svg-icon--wrapper .sqs-use--icon {\n        fill: var(--si-fill-icon-fade, var(--si-fill-icon, transparent));\n      }\n      #block-f103d0b2e3d5b460e844 .sqs-svg-icon--list:hover .sqs-svg-icon--wrapper .sqs-use--mask {\n        fill: var(--si-fill-mask-fade, var(--si-fill-mask, transparent));\n      }\n      #block-f103d0b2e3d5b460e844 .sqs-svg-icon--list:hover .sqs-svg-icon--wrapper:hover {\n        background-color: var(--si-bg-hover, var(--si-bg, transparent));\n      }\n      #block-f103d0b2e3d5b460e844 .sqs-svg-icon--list:hover .sqs-svg-icon--wrapper:hover .sqs-use--icon {\n        fill: var(--si-fill-icon-hover, var(--si-fill-icon, transparent));\n      }\n      #block-f103d0b2e3d5b460e844 .sqs-svg-icon--list:hover .sqs-svg-icon--wrapper:hover .sqs-use--mask {\n        fill: var(--si-fill-mask-hover, var(--si-fill-mask, transparent));\n      }\n    </style>\n    <nav class=\"sqs-svg-icon--list\">\n      \n        \n          <a\n            href=\"https://www.instagram.com/low_gh0st/\"\n            target=\"_blank\"\n   